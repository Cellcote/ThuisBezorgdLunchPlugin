{
  "manifest_version": 3,
  "name": "ThuisBezorgd Lunch Filter",
  "version": "3.0.1",
  "description": "Lunch filter for ThuisBezorgd: < 1.5 km, open 12-14, sorted by distance, shows where colleagues order",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://cloud.uipath.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.thuisbezorgd.nl/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
